<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report7" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<queryString><![CDATA[
		SELECT product_no
		
		#foreach ($columnName in $columnNames)
		,COALESCE("${columnName}", 0) AS "${columnName}"
		#end
		
      FROM crosstab ('$!{sqlQuery}', 'SELECT ARRAY[
    #set($i = 0)
    #foreach ($columnName in $columnNames)
    	#if ($i != 0) , #end
    	''${columnName}''
    	
    	#set($i = $i + 1)
    #end
    ]
    FROM generate_series(array_lower(ARRAY[
    #set($i = 0)
    #foreach ($columnName in $columnNames)
    	#if ($i != 0) , #end
    	''${columnName}''
    	
    	#set($i = $i + 1)
    #end
    ], 1), array_upper(ARRAY[
    #set($i = 0)
    #foreach ($columnName in $columnNames)
    	#if ($i != 0) , #end
    	''${columnName}''
    	
    	#set($i = $i + 1)
    #end
    ], 1)) i;
      ')
        AS (product_no VARCHAR
    
    #foreach ($columnName in $columnNames)
		,"${columnName}" NUMERIC
		#end
           );
	]]></queryString>
	<field name="product_no" class="java.lang.String"/>
	#foreach ($columnName in $columnNames)
	<field name="${columnName}" class="java.math.BigDecimal"/>
	#end
	<variable name="dealerLeftQty" class="java.math.BigDecimal" resetType="None">
		<variableExpression><![CDATA[
		0
		#foreach ($columnName in $columnNames)
		+ $F{${columnName}}
		#end
		]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="124" splitType="Stretch">
			<staticText>
				<reportElement x="176" y="0" width="262" height="46"/>
				<textElement>
					<font size="24"/>
				</textElement>
				<text><![CDATA[BALANCE BY DEALER]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="57" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[Warehouse]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="57" width="113" height="20"/>
				<textElement/>
				<text><![CDATA[HN22]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="77" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[Person]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="77" width="113" height="20"/>
				<textElement/>
				<text><![CDATA[Tong]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="97" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[31/03/2011]]></text>
			</staticText>
		</band>
	</title>
	<pageHeader>
		<band height="35" splitType="Stretch"/>
	</pageHeader>
	<columnHeader>
		<band height="26" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="0" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[Product No.]]></text>
			</staticText>
			<staticText>
				<reportElement x="113" y="0" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[Sum]]></text>
			</staticText>
			#set($i = 0)
			#foreach ($columnName in $columnNames)
			#set ($x = $i * 100 + 213)
			<staticText>
				<reportElement x="${x}" y="0" width="100" height="20"/>
				<textElement/>
				<text><![CDATA[cpn_viet_nam]]></text>
			</staticText>
			#set($i = $i + 1)
			#end
		</band>
	</columnHeader>
	<detail>
		<band height="22" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="100" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{product_no}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="113" y="0" width="100" height="20"/>
				<textElement/>
				<textFieldExpression class="java.lang.String"><![CDATA[$V{dealerLeftQty}]]></textFieldExpression>
			</textField>
			#set($i = 0)
			#foreach ($columnName in $columnNames)
			#set ($x = $i * 100 + 213)
			<textField>
				<reportElement x="${x}" y="2" width="100" height="20"/>
				<textElement/>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{${columnName}]]></textFieldExpression>
			</textField>
			#set($i = $i + 1)
			#end
		</band>
	</detail>
	<columnFooter>
		<band height="45" splitType="Stretch"/>
	</columnFooter>
	<pageFooter>
		<band height="54" splitType="Stretch"/>
	</pageFooter>
	<summary>
		<band height="42" splitType="Stretch"/>
	</summary>
</jasperReport>
